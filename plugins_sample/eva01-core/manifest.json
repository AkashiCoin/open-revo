{
  "id": "eva01-core",
  "name": "EVA-01 初号机 S2 能量核心",
  "version": "1.0.0",
  "author": "OpenRevo Official",
  "description": "官方标杆级异形拟态机甲桌宠挂件，支持结温脉冲呼吸、风扇转速联动与一键强冷暴走切换。",
  "type": "widget",
  "window": {
    "width": 260,
    "height": 180,
    "transparent": true,
    "alwaysOnTop": true,
    "resizable": false
  },
  "telemetry": {
    "enabled": true,
    "desiredIntervalMs": 1500,
    "sensors": [
      "cpu_temp",
      "cpu_fan_rpm",
      "cpu_power_w",
      "power_mode",
      "fan_boost"
    ]
  }
}
