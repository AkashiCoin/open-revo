{
  "$schema": "https://openrevo.org/schemas/model-driver.v1.json",
  "id": "mechrevo_jiaolong_16_bld",
  "name": "MECHREVO Jiaolong 16 Pro (AMD Dragon Range / Baolongda MRID6)",
  "version": "1.0.0",
  "author": "OpenRevo Core Team",
  "identity": {
    "form_factor": "gaming",
    "ui_preset": "gaming_full",
    "dmi_match": {
      "vendor": "MECHREVO",
      "board_products": ["*MRID6*", "*JIAOLONG 16 PRO*", "*JIAOLONG16PRO*", "*JIAOLONG 16*", "*JIAOLONG16*"],
      "product_names": ["*JIAOLONG 16 PRO*", "*MRID6*", "*JIAOLONG16PRO*", "*JIAOLONG 16*", "*JIAOLONG16*"]
    }
  },
  "capabilities": {
    "discrete_gpu": true,
    "gpu_mux_type": "dual_mode",
    "supported_gpu_modes": ["hybrid", "dgpu"],
    "water_cooling": false,
    "fan_custom_curve": true,
    "fan_independent_channels": true,
    "fan_ramp_rate": false,
    "fan_control_mode": "direct_rpm_clamp",
    "fan_boost_mode": "direct_rpm_clamp",
    "max_fan_rpm": 5800,
    "cpu_vendor": "amd",
    "cpu_tuning_type": "amd_smu",
    "cpu_supports_fppt": false,
    "gpu_power_tuning_mode": "mode_locked",
    "battery_charge_limit": false,
    "power_modes": ["office", "balance", "turbo", "custom"],
    "power_mode_watts": {
      "office": 45,
      "balance": 80,
      "turbo": 115,
      "custom": 115
    },
    "keyboard": {
      "supported": true,
      "type": "single_zone_rgb",
      "steps": [0, 1, 2, 3],
      "hardware_autonomous": false,
      "hotkey_osd_only": false,
      "sleep_timeout_supported": false,
      "timeout_options_seconds": []
    },
    "osd_notifications": {
      "power_mode_switch": true,
      "backlight_level_change": true,
      "touchpad_lock": true
    }
  },
  "channels": {
    "wmi_mailbox": {
      "type": "wmi_mailbox",
      "namespace": "root\\WMI",
      "class_name": "MICommonInterface",
      "method_name": "MiInterface",
      "buffer_sizes": {
        "in": 32,
        "out": 32
      }
    }
  },
  "actions": {
    "read_fan_rpm": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 13, 0],
      "parse": {
        "gpu_rpm": { "offset": 4, "type": "u16_le" },
        "cpu_rpm": { "offset": 6, "type": "u16_le" }
      }
    },
    "get_power_mode": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 8, 0],
      "parse": {
        "mode_code": { "offset": 4, "type": "u8" }
      },
      "mapping": {
        "2": "office",
        "0": "balance",
        "1": "turbo"
      }
    },
    "set_power_mode": {
      "office": [0, 251, 0, 8, 2],
      "balance": [0, 251, 0, 8, 0],
      "turbo": [0, 251, 0, 8, 1],
      "custom": [0, 251, 0, 8, 1]
    },
    "read_cpu_temp": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 22, 0],
      "parse": {
        "cpu_temp": { "offset": 4, "type": "u8" }
      }
    },
    "set_keyboard_backlight": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 18, "{val}"]
    },
    "set_keyboard_rgb": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 17, "{r}", "{g}", "{b}"]
    },
    "set_keyboard_mode_fixed": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 16, 2]
    },
    "set_keyboard_mode_cyclic": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 16, 1]
    },
    "set_keyboard_mode_off": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 16, 0]
    },
    "set_fan_boost_on": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 20, 1]
    },
    "set_fan_boost_off": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 20, 0]
    },
    "get_gpu_mux": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 9, 0],
      "parse": {
        "mode_code": { "offset": 4, "type": "u8" }
      },
      "mapping": {
        "0": "hybrid",
        "1": "dgpu"
      }
    },
    "set_gpu_mux_hybrid": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 9, 0]
    },
    "set_gpu_mux_discrete": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 9, 1]
    },
    "switch_touchpad_on": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 12, 0]
    },
    "switch_touchpad_off": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 12, 1]
    },
    "switch_fn_lock_on": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 11, 1]
    },
    "switch_fn_lock_off": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 11, 0]
    },
    "switch_logo_light_on": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 15, 1]
    },
    "switch_logo_light_off": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 15, 0]
    },
    "set_cpu_spl": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 23, 2, "{val}"]
    },
    "set_cpu_sppt": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 23, 3, "{val}"]
    },
    "set_cpu_temp_wall": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 23, 4, "{val}"]
    }
  },
  "guardrails": {
    "safe_commands_only": true,
    "pl1_watts_limit": {
      "min": 25,
      "max": 100
    },
    "pl2_watts_limit": {
      "min": 30,
      "max": 130
    }
  }
}
