{
  "$schema": "https://openrevo.org/schemas/model-driver.v1.json",
  "id": "mechrevo_wujie_14_ip3",
  "name": "MECHREVO Wujie 14 (AMD Ryzen 7000 / IP3 xN39 Board)",
  "version": "1.0.0",
  "author": "OpenRevo Core Team",
  "identity": {
    "form_factor": "thin_light",
    "ui_preset": "ultrabook_compact",
    "dmi_match": {
      "vendor": "MECHREVO",
      "board_products": ["IP3_ARN39*", "WUJIE 14*", "ARN39*"],
      "product_names": ["WUJIE 14*", "WUJIE14*"]
    }
  },
  "capabilities": {
    "discrete_gpu": false,
    "water_cooling": false,
    "fan_custom_curve": false,
    "battery_charge_limit": false,
    "fn_lock": false,
    "power_modes": ["office", "balance", "turbo"],
    "power_mode_watts": {
      "office": 35,
      "balance": 45,
      "turbo": 54
    },
    "rgb_keyboard": {
      "supported": true,
      "type": "monochrome_stepped",
      "steps": [1, 2],
      "hardware_autonomous": false,
      "hotkey_osd_only": false,
      "sleep_timeout_supported": false,
      "timeout_options_seconds": []
    },
    "osd_notifications": {
      "power_mode_switch": true,
      "backlight_level_change": true
    }
  },
  "channels": {
    "wmi_ip3": {
      "type": "wmi_ip3"
    }
  },
  "actions": {
    "set_power_mode": {
      "office": [2],
      "balance": [0],
      "turbo": [1]
    },
    "set_keyboard_backlight": {
      "channel": "wmi_ip3",
      "input": [3, 226, "{val}"]
    }
  },
  "guardrails": {
    "safe_commands_only": true,
    "pl1_watts_limit": {
      "min": 15,
      "max": 54
    }
  }
}
