{
  "$schema": "https://openrevo.org/schemas/model-driver.v1.json",
  "id": "mechrevo_xingyao_14_p916f",
  "name": "MECHREVO Xingyao 14 (AMD Ryzen AI / Intel Lunar Lake)",
  "version": "1.1.0",
  "author": "OpenRevo Core Team",
  "identity": {
    "form_factor": "thin_light",
    "ui_preset": "ultrabook_compact",
    "dmi_match": {
      "vendor": "MECHREVO",
      "board_products": ["XINGYAO Series-P916F-STX", "XINGYAO Series-P916F-PTL", "P916F*"],
      "product_names": ["XINGYAO Series"]
    }
  },
  "capabilities": {
    "discrete_gpu": false,
    "water_cooling": false,
    "fan_custom_curve": false,
    "battery_charge_limit": true,
    "power_modes": ["office", "balance", "turbo"],
    "power_mode_watts": {
      "office": 20,
      "balance": 28,
      "turbo": 38
    },
    "rgb_keyboard": {
      "supported": false,
      "type": "none",
      "hardware_autonomous": true,
      "hotkey_osd_only": true,
      "sleep_timeout_supported": true,
      "timeout_options_seconds": [0, 10, 15, 30, 60]
    },

    "osd_notifications": {
      "power_mode_switch": true,
      "backlight_level_change": true
    }
  },
  "channels": {
    "wmi_mailbox": {
      "type": "wmi_mailbox",
      "namespace": "root\\wmi",
      "class_name": "OemWMIMethod",
      "method_name": "OemWMIfun",
      "fallback_classes": ["AcpiTest_WMI"],
      "buffer_sizes": {
        "in": 64,
        "out": 256
      }
    }
  },
  "actions": {
    "read_fan_rpm": {
      "channel": "wmi_mailbox",
      "input": [2, 1],
      "parse": {
        "cpu_rpm": { "offset": 1, "type": "u16_le" },
        "gpu_rpm": { "offset": 3, "type": "u16_le" }
      }
    },
    "get_power_mode": {
      "channel": "wmi_mailbox",
      "input": [3, 9],
      "parse": {
        "mode_code": { "offset": 1, "type": "u8" }
      },
      "mapping": {
        "1": "office",
        "2": "balance",
        "3": "turbo"
      }
    },
    "set_power_mode": {
      "office": [3, 10, 1],
      "balance": [3, 10, 2],
      "turbo": [3, 10, 3]
    },
    "set_kb_sleep_timeout": {
      "always_on": [3, 12, 1, 0],
      "timeout_10s": [3, 12, 0, 0]
    }
  },
  "guardrails": {
    "safe_commands_only": true,
    "amd_turbo_charger_required_watts": 65,
    "pl1_watts_limit": {
      "min": 15,
      "max": 65
    }
  }
}
